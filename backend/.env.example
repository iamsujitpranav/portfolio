# ------------------------------------------------------------------
# FastAPI backend config. Copy to backend/.env for local dev, or set
# on the Hostinger VPS. Never commit the real .env.
# ------------------------------------------------------------------

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# Default claude-opus-4-8. For a busy public widget, claude-sonnet-5 is cheaper
# (a deliberate downgrade — set it here if you want it).
ANTHROPIC_MODEL=claude-opus-4-8

# --- PostgreSQL (SQLAlchemy async / asyncpg) ---
# Leave unset for early local dev: contact still emails and chat falls back to
# full-context injection. Set it to enable lead persistence + pgvector RAG.
DATABASE_URL=postgresql+asyncpg://portfolio:portfolio@localhost:5432/portfolio

# --- Embeddings for pgvector RAG (pick ONE provider) ---
# Voyage AI (Anthropic-recommended). voyage-3 => 1024 dims.
VOYAGE_API_KEY=
# OR OpenAI. text-embedding-3-small => 1536 dims.
OPENAI_API_KEY=
# Must match the provider/model output dimension. Voyage voyage-3 = 1024,
# OpenAI text-embedding-3-small = 1536. Keep in sync with your ingested vectors.
EMBED_DIM=1024

# --- Contact form (SMTP) ---
# Gmail: use an App Password (myaccount.google.com/apppasswords), not your
# account password. Port 465 = implicit SSL.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
# Gmail requires From to be the authenticated account; omit to default to SMTP_USER.
SMTP_FROM=you@gmail.com
CONTACT_TO_EMAIL=sujitreddy0602@gmail.com

# --- CORS: comma-separated origins allowed to call this API directly ---
# (Not needed when Nginx serves frontend + API on the same origin.)
CORS_ORIGINS=http://localhost:3000

# --- Admin auth (blog authoring). Both must be set or /api/admin/* is inert. ---
ADMIN_PASSWORD=
# Signs admin session tokens: `python -c "import secrets;print(secrets.token_urlsafe(48))"`
SESSION_SECRET=
ADMIN_TOKEN_TTL=604800

# --- Abuse protection ---
# Per-IP rate limits as comma-separated "hits/seconds" pairs (a burst rule plus
# a sustained one). Counters are per worker process; nginx `limit_req` is the
# cross-worker edge limit (see deploy/nginx.conf).
RATE_LIMIT_ENABLED=1
CHAT_RATE_LIMIT=12/300, 60/3600
CONTACT_RATE_LIMIT=3/600, 10/86400
# Failed admin logins only — a successful login refunds the caller's budget.
LOGIN_RATE_LIMIT=5/900, 20/86400
# Read the caller IP from X-Real-IP / X-Forwarded-For. Correct behind nginx;
# set to 0 if uvicorn is ever reachable directly, since those headers are
# forgeable and would let a caller sidestep every per-IP limit.
TRUST_PROXY_HEADERS=1
# Chat payload ceilings (characters) — caps the input-token bill per request.
CHAT_MAX_MESSAGE_CHARS=2000
CHAT_MAX_TOTAL_CHARS=12000
