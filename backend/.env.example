# ------------------------------------------------------------------
# FastAPI backend config. Copy to backend/.env for local dev, or set
# on the Hostinger VPS. Never commit the real .env.
#
# RUNNING UNDER DOCKER? This file is not read. compose.yaml passes the
# backend an explicit environment sourced from the REPO-ROOT .env, and a
# real env var beats backend/.env — so a value set here would silently
# do nothing. Edit the root .env (and compose.yaml, if the key is new).
# ------------------------------------------------------------------

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# The chat answers 2–4 sentences strictly from context that is handed to it in
# the prompt, with an explicit instruction never to invent facts. That is
# grounded extraction, not reasoning, and Haiku does it for a small fraction of
# an Opus call — which is the single largest lever on what this site costs to
# run. Raise it to claude-sonnet-5 if the answers ever read thin.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- PostgreSQL (SQLAlchemy async / asyncpg) ---
# Leave unset for early local dev: contact still emails and chat falls back to
# full-context injection. Set it to enable lead persistence + pgvector RAG.
DATABASE_URL=postgresql+asyncpg://portfolio:portfolio@localhost:5432/portfolio

# --- Embeddings for pgvector RAG (pick ONE provider) ---
# Voyage AI (Anthropic-recommended). voyage-3 => 1024 dims.
VOYAGE_API_KEY=
# OR OpenAI. text-embedding-3-small => 1536 dims.
OPENAI_API_KEY=
# Must match the provider/model output dimension. Voyage voyage-3 = 1024,
# OpenAI text-embedding-3-small = 1536. Keep in sync with your ingested vectors.
EMBED_DIM=1024

# --- Contact form (SMTP) ---
# Gmail: use an App Password (myaccount.google.com/apppasswords), not your
# account password. Port 465 = implicit SSL.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
# Gmail requires From to be the authenticated account; omit to default to SMTP_USER.
SMTP_FROM=you@gmail.com
CONTACT_TO_EMAIL=contact@sujitpranavreddy.dev

# --- CORS: comma-separated origins allowed to call this API directly ---
# (Not needed when Nginx serves frontend + API on the same origin.)
CORS_ORIGINS=http://localhost:61991

# --- Admin auth (blog authoring). Password + session secret are required;
# production also requires a base32 TOTP secret for MFA. ---
ADMIN_PASSWORD=
# Signs admin session tokens: `python -c "import secrets;print(secrets.token_urlsafe(48))"`
SESSION_SECRET=
# Optional base32 TOTP secret for the admin authenticator app.
ADMIN_TOTP_SECRET=
ADMIN_MFA_REQUIRED=0
ADMIN_SESSION_EPOCH=1
ADMIN_TOKEN_TTL=604800

# --- Abuse protection ---
# Per-IP rate limits as comma-separated "hits/seconds" pairs (a burst rule plus
# a sustained one). Counters are per worker process; nginx `limit_req` is the
# cross-worker edge limit (see deploy/nginx.conf).
RATE_LIMIT_ENABLED=1
CHAT_RATE_LIMIT=12/300, 60/3600
CONTACT_RATE_LIMIT=3/600, 10/86400
# Failed admin logins only — a successful login refunds the caller's budget.
LOGIN_RATE_LIMIT=5/900, 20/86400
# Read the caller IP from X-Real-IP / X-Forwarded-For. Correct behind nginx;
# set to 0 if uvicorn is ever reachable directly, since those headers are
# forgeable and would let a caller sidestep every per-IP limit.
TRUST_PROXY_HEADERS=1
# Chat payload ceilings (characters) — caps the input-token bill per request.
CHAT_MAX_MESSAGE_CHARS=2000
CHAT_MAX_TOTAL_CHARS=12000

# --- Chat cost controls ---
# Ceiling on the answer, not a target: the prompt asks for 2–4 sentences (~100
# tokens) and output bills several times input.
CHAT_MAX_TOKENS=400
# Cache the system block (instructions + résumé) with Anthropic — worth about
# 90% of the input cost of every question, because with RAG off that block is
# byte-identical on every request. Silently becomes a no-op if the block falls
# under the model's cache minimum (1024 tokens; 2048 on Haiku — the résumé is
# ~2.5k, so watch it if content/resume.json ever shrinks).
CHAT_PROMPT_CACHE=1
# Refuse prompt injection, "write me a Python script" and the weather before a
# token is spent. See backend/app/guard.py.
CHAT_GUARD_ENABLED=1
# Reuse the answer to a repeated OPENING question. The suggestion chips in the
# assistant are one click each and are asked far more than anything else, so
# this is where the hit rate lives. Per worker, in memory.
CHAT_CACHE_ENABLED=1
CHAT_CACHE_SIZE=256
CHAT_CACHE_TTL=86400

# --- Journey analytics (first-party, anonymous) ---
# The 3D journey reports what visitors actually open — stops, landmarks, games,
# where they leave. Stored in the `journey_events` table with a random per-tab
# session id and NO IP, cookie or user agent; the browser also honours
# Do-Not-Track before a request is made. Off here means /api/events accepts and
# discards, so no frontend change is needed to switch it off.
ANALYTICS_ENABLED=1
LEAD_RETENTION_DAYS=730
ANALYTICS_RETENTION_DAYS=90
EVENTS_RATE_LIMIT=60/60, 600/3600
EVENTS_MAX_PER_BATCH=50
# Read the results at /admin/analytics (needs ADMIN_PASSWORD + SESSION_SECRET + MFA settings).
#
# Store WHAT visitors asked the résumé assistant, not just how many asked. It is
# the most useful thing in the table — a recruiter's question is them telling you
# what the résumé failed to answer — but it is the one field someone could type
# their own name into, so it is off unless you say otherwise. The browser sends
# it either way; off means the backend drops it before the insert, so flipping
# this takes effect on the next request with no frontend rebuild.
ANALYTICS_QUESTIONS=0
