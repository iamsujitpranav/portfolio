# ------------------------------------------------------------------
# Copy to .env.local for development, or set these on the Hostinger VPS.
# NEVER commit the real .env.
# ------------------------------------------------------------------

# --- "Ask my résumé" AI chat (Anthropic Claude) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Default is claude-opus-4-8. For a high-traffic public widget you may prefer
# claude-sonnet-5 to cut cost — it's a deliberate downgrade, so set it here.
ANTHROPIC_MODEL=claude-opus-4-8

# --- Contact form (SMTP) ---
# Gmail: create an App Password (myaccount.google.com/apppasswords) — your normal
# account password will NOT work. Port 465 = implicit SSL.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
# Gmail requires From to be the authenticated account; omit to default to SMTP_USER.
SMTP_FROM=you@gmail.com
# Where contact submissions are delivered.
CONTACT_TO_EMAIL=sujitreddy0602@gmail.com

# --- Analytics (optional, Umami) ---
# Self-host Umami on the same VPS or use Umami Cloud, then set:
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Public site URL (used for metadata / canonical / sitemap) ---
# Baked into the frontend at BUILD time, so changing it needs a rebuild.
NEXT_PUBLIC_SITE_URL=https://sujitpranavreddy.dev
