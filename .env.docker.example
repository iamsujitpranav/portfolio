# Copy this file to .env.docker, replace the placeholder values, then run:
# docker compose --env-file .env.docker up --build -d --wait

# Published HTTP port and public URL baked into Next.js metadata.
APP_PORT=61991
NEXT_PUBLIC_SITE_URL=http://localhost:61991

# Database. Use a long URL-safe password in production.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio

# Claude resume chat.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# RAG embeddings: configure Voyage OR OpenAI, then run the ingest command from
# the README. Keep EMBED_DIM aligned with the selected model.
VOYAGE_API_KEY=
OPENAI_API_KEY=
EMBED_DIM=1024
VOYAGE_MODEL=voyage-3
OPENAI_EMBED_MODEL=text-embedding-3-small

# Contact form email (optional; submissions still persist to PostgreSQL).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_TO_EMAIL=contact@sujitpranavreddy.dev

# Blog admin (both are required to enable admin routes).
ADMIN_PASSWORD=
SESSION_SECRET=
# Optional base32 TOTP secret for the admin authenticator app.
ADMIN_TOTP_SECRET=
ADMIN_MFA_REQUIRED=0
ADMIN_SESSION_EPOCH=1

# Optional analytics, baked into the frontend image at build time.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
