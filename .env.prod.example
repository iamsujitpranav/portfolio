# ---------------------------------------------------------------------------
# Production environment for sujitpranavreddy.dev.
#
#   cp .env.prod.example .env.prod   # on the server, then fill in every blank
#   chmod 600 .env.prod
#
# Read by compose.prod.yaml (`--env-file .env.prod`) and scripts/deploy.sh.
# NEVER commit the filled-in copy — .gitignore already covers .env.prod.
#
# NEXT_PUBLIC_* values are BAKED INTO THE FRONTEND IMAGE at build time, so
# changing one needs a rebuild (`scripts/deploy.sh` always rebuilds), not just
# a restart.
# ---------------------------------------------------------------------------

# --- Published port --------------------------------------------------------
# The stack's one and only published port. The shared Caddy container on the
# VPS proxies sujitpranavreddy.dev to it; nothing else on the box uses 61991.
APP_PORT=61991
# Which host address that port binds to:
#   172.17.0.1 the Docker bridge address of the host: Caddy can reach it, the
#              internet cannot. This is the safe default.
#   0.0.0.0    only use temporarily before DNS moves; it exposes plain HTTP.
APP_BIND=172.17.0.1

# --- Public URL ------------------------------------------------------------
# Baked into the frontend image at build time (metadata, canonical, sitemap).
NEXT_PUBLIC_SITE_URL=https://sujitpranavreddy.dev

# --- Database --------------------------------------------------------------
# Generate the password with `openssl rand -base64 24 | tr -d '/+='`.
# It ends up inside a URL, so keep it URL-safe.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=
POSTGRES_DB=portfolio

# --- Backend CORS ----------------------------------------------------------
# Everything is same-origin behind nginx, so this only needs the public site.
CORS_ORIGINS=https://sujitpranavreddy.dev,https://www.sujitpranavreddy.dev

# --- Claude résumé chat ----------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- RAG embeddings (optional) ---------------------------------------------
# There is no RAG on/off switch: RAG_ENABLED is derived as
# `DATABASE_URL set AND (VOYAGE_API_KEY OR OPENAI_API_KEY) set`
# (backend/app/config.py). Filling in ONE of the two keys below is what turns
# it on; /api/health then reports "rag": true. With neither set, chat still
# works — it just falls back to the whole résumé as context instead of
# retrieved chunks, and the articles are not reachable by chat at all.
#
# Whichever key you set, run the ingest afterwards or the index stays empty:
#   INGEST=1 ./scripts/deploy.sh <tag>
#
# EMBED_DIM MUST MATCH THE MODEL THAT PRODUCES THE VECTORS:
#   text-embedding-3-small (OpenAI) -> 1536   <- what this file is set up for
#   voyage-3 (Voyage)               -> 1024
# The backend never asks OpenAI to shorten its output, so the full 1536 is
# what arrives.
#
# ‼️ EMBED_DIM is baked into the documents.embedding column the first time the
# table is created, and create_all skips tables that already exist — so on a
# database that has already booted once, editing EMBED_DIM alone does NOTHING
# and ingest fails on a dimension mismatch. Drop the table so the next boot
# recreates it at the new width (it holds only derived data; ingest rewrites
# it from scratch every run):
#   docker compose -f compose.prod.yaml --env-file .env.prod \
#     exec db psql -U portfolio -d portfolio -c 'DROP TABLE IF EXISTS documents'
VOYAGE_API_KEY=
OPENAI_API_KEY=
EMBED_DIM=1536
VOYAGE_MODEL=voyage-3
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Contact form email (optional; submissions persist to Postgres anyway) --
# Gmail needs an App Password (myaccount.google.com/apppasswords), not the
# account password. Port 465 = implicit SSL.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_TO_EMAIL=contact@sujitpranavreddy.dev

# --- Blog admin ------------------------------------------------------------
# All three are required before /admin does anything; MFA is fail-closed. Generate the
# password and session secret with:
#   openssl rand -base64 32
ADMIN_PASSWORD=
SESSION_SECRET=
# Base32 secret for authenticator-app MFA. Leave blank only for local development.
ADMIN_TOTP_SECRET=
# Set to 1 in production; missing secret then fails closed.
ADMIN_MFA_REQUIRED=1
# Rotate this value to invalidate every existing admin token.
ADMIN_SESSION_EPOCH=1
ADMIN_TOKEN_TTL=604800

# --- Abuse protection ------------------------------------------------------
# Leave these alone unless the site is being hammered. nginx enforces a blunter
# ceiling in front of them (deploy/nginx.prod.conf.template).
RATE_LIMIT_ENABLED=1
CHAT_RATE_LIMIT=12/300, 60/3600
CONTACT_RATE_LIMIT=3/600, 10/86400
LOGIN_RATE_LIMIT=5/900, 20/86400
# ON is correct behind the nginx in compose.prod.yaml — it overwrites X-Real-IP
# with the real socket address, so the per-IP budgets can't be spoofed. Only
# turn this OFF if uvicorn is ever exposed directly to the internet.
TRUST_PROXY_HEADERS=1

# --- Chat cost controls ----------------------------------------------------
CHAT_MAX_MESSAGE_CHARS=2000
CHAT_MAX_TOTAL_CHARS=12000
CHAT_MAX_TOKENS=400
CHAT_PROMPT_CACHE=1
CHAT_GUARD_ENABLED=1
CHAT_CACHE_ENABLED=1
CHAT_CACHE_SIZE=256
CHAT_CACHE_TTL=86400

# --- Journey analytics -----------------------------------------------------
ANALYTICS_ENABLED=1
LEAD_RETENTION_DAYS=730
ANALYTICS_RETENTION_DAYS=90
# Storing the TEXT of visitor questions is off by default — a visitor can type
# anything into that box, including their own name.
ANALYTICS_QUESTIONS=0

# --- Optional third-party analytics (baked into the image) -----------------
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Optional CDN-hosted 3D assets (baked into the image) ------------------
# Leave blank to serve the avatar + animations from /public in the image.
NEXT_PUBLIC_AVATAR_URL=
NEXT_PUBLIC_ANIMATIONS_URL=
NEXT_PUBLIC_AVATAR_FALLBACK=
